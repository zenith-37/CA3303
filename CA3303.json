    {
      "order": 16,
      "file_name": "RpcServer.java",
      "topic": "Hand-written RPC",
      "description": "RPC server skeleton: receives RpcRequest objects, dispatches to CalculatorService and returns an RpcResponse.",
      "code": [
        "import java.io.*;",
        "import java.net.*;",
        "",
        "/*",
        " * Hand-written RPC server (\"skeleton\"): listens for RpcRequest objects,",
        " * dispatches them to the real CalculatorService, and returns an RpcResponse.",
        " * This shows the marshalling/unmarshalling + dispatch that a real RPC/RMI",
        " * runtime does for you automatically.",
        " */",
        "public class RpcServer {",
        "    static final int PORT = 5000;",
        "",
        "    public static void main(String[] args) throws IOException {",
        "        CalculatorService service = new CalculatorService();",
        "        try (ServerSocket serverSocket = new ServerSocket(PORT)) {",
        "            System.out.println(\"RPC Server listening on port \" + PORT + \" ...\");",
        "            while (true) {",
        "                Socket socket = serverSocket.accept();",
        "                new Thread(() -> handleClient(socket, service)).start();",
        "            }",
        "        }",
        "    }",
        "",
        "    static void handleClient(Socket socket, CalculatorService service) {",
        "        try (ObjectInputStream in = new ObjectInputStream(socket.getInputStream());",
        "             ObjectOutputStream out = new ObjectOutputStream(socket.getOutputStream())) {",
        "",
        "            RpcRequest req = (RpcRequest) in.readObject();",
        "            System.out.println(\"Received call: \" + req.methodName",
        "                    + \"(\" + req.params[0] + \", \" + req.params[1] + \")\");",
        "",
        "            RpcResponse resp;",
        "            try {",
        "                double a = (double) req.params[0];",
        "                double b = (double) req.params[1];",
        "                double result;",
        "                switch (req.methodName) {",
        "                    case \"add\": result = service.add(a, b); break;",
        "                    case \"sub\": result = service.sub(a, b); break;",
        "                    case \"mul\": result = service.mul(a, b); break;",
        "                    case \"div\": result = service.div(a, b); break;",
        "                    default: throw new NoSuchMethodException(req.methodName);",
        "                }",
        "                resp = new RpcResponse(result, null);",
        "            } catch (Exception e) {",
        "                resp = new RpcResponse(null, e.getMessage());",
        "            }",
        "            out.writeObject(resp);",
        "        } catch (IOException | ClassNotFoundException e) {",
        "            e.printStackTrace();",
        "        } finally {",
        "            try { socket.close(); } catch (IOException ignored) {}",
        "        }",
        "    }",
        "}",
        ""
      ]
    },
    {
      "order": 17,
      "file_name": "VectorClockDemo.java",
      "topic": "Distributed Clocks",
      "description": "Vector clock simulation with 3 processes, showing happened-before and concurrent event detection.",
      "code": [
        "import java.util.*;",
        "import java.util.concurrent.*;",
        "",
        "/*",
        " * Vector Clock demo (3 processes: P1, P2, P3) - same scenario as the",
        " * Lamport clock demo, so you can compare the two directly.",
        " *",
        " * Rules implemented:",
        " *   1. Each process Pi keeps a vector V[1..N]. V[i] is \"my own\" component.",
        " *   2. Before any event (internal or send), Pi increments V[i].",
        " *   3. On receiving a message carrying vector Vm, Pi does:",
        " *        V[k] = max(V[k], Vm[k])  for every k",
        " *        V[i] = V[i] + 1",
        " *   4. Event ordering from two vectors Va (event a) and Vb (event b):",
        " *        Va <= Vb component-wise and Va != Vb   => a happened-before b",
        " *        Vb <= Va component-wise and Va != Vb   => b happened-before a",
        " *        neither                                => a and b are CONCURRENT",
        " */",
        "public class VectorClockDemo {",
        "",
        "    static final int N = 3; // number of processes",
        "",
        "    static class Message {",
        "        int senderId;",
        "        int[] vector;",
        "        String content;",
        "        Message(int senderId, int[] vector, String content) {",
        "            this.senderId = senderId;",
        "            this.vector = vector.clone();",
        "            this.content = content;",
        "        }",
        "    }",
        "",
        "    static class Process {",
        "        final int id; // 0-based index into the vector",
        "        final int[] V = new int[N];",
        "        final BlockingQueue<Message> inbox = new LinkedBlockingQueue<>();",
        "",
        "        Process(int id) { this.id = id; }",
        "",
        "        synchronized int[] tick() {",
        "            V[id]++;",
        "            return V.clone();",
        "        }",
        "",
        "        synchronized int[] receiveTick(int[] incoming) {",
        "            for (int k = 0; k < N; k++) V[k] = Math.max(V[k], incoming[k]);",
        "            V[id]++;",
        "            return V.clone();",
        "        }",
        "",
        "        void log(String event) {",
        "            System.out.printf(\"[P%d] V=%s -> %s%n\", id + 1, Arrays.toString(V), event);",
        "        }",
        "    }",
        "",
        "    // Compares two vector timestamps and reports the happened-before / concurrent relation",
        "    static String compare(int[] a, int[] b) {",
        "        boolean aLessEq = true, bLessEq = true;",
        "        for (int k = 0; k < N; k++) {",
        "            if (a[k] > b[k]) aLessEq = false;",
        "            if (b[k] > a[k]) bLessEq = false;",
        "        }",
        "        if (Arrays.equals(a, b)) return \"identical\";",
        "        if (aLessEq) return \"first happened-before second\";",
        "        if (bLessEq) return \"second happened-before first\";",
        "        return \"CONCURRENT (neither happened-before the other)\";",
        "    }",
        "",
        "    public static void main(String[] args) throws InterruptedException {",
        "        Process p1 = new Process(0);",
        "        Process p2 = new Process(1);",
        "        Process p3 = new Process(2);",
        "",
        "        int[] e1 = p1.tick();               p1.log(\"internal event e1\");",
        "        int[] e2 = p1.tick();                p1.log(\"send m1 to P2\");",
        "        p2.inbox.put(new Message(0, e2, \"m1\"));",
        "",
        "        int[] e3 = p2.tick();                p2.log(\"internal event e3\");",
        "",
        "        Message m1 = p2.inbox.take();",
        "        int[] e4 = p2.receiveTick(m1.vector); p2.log(\"receive m1\");",
        "",
        "        int[] e5 = p2.tick();                p2.log(\"send m2 to P3\");",
        "        p3.inbox.put(new Message(1, e5, \"m2\"));",
        "",
        "        int[] e6 = p3.tick();                p3.log(\"internal event e6\");",
        "",
        "        Message m2 = p3.inbox.take();",
        "        int[] e7 = p3.receiveTick(m2.vector); p3.log(\"receive m2\");",
        "",
        "        int[] e8 = p1.tick();                p1.log(\"internal event e8\");",
        "",
        "        System.out.println(\"\\n-- Event ordering analysis (this is what Lamport clocks CANNOT do reliably) --\");",
        "        System.out.println(\"e2 (P1 send m1) vs e4 (P2 receive m1): \" + compare(e2, e4));",
        "        System.out.println(\"e1 (P1 internal) vs e6 (P3 internal) : \" + compare(e1, e6));",
        "        System.out.println(\"e8 (P1 internal) vs e6 (P3 internal) : \" + compare(e8, e6)",
        "                + \"   <-- both had Lamport clock value close together, vector clocks correctly show no causal link\");",
        "        System.out.println(\"e2 (P1 send m1) vs e7 (P3 receive m2): \" + compare(e2, e7)",
        "                + \"   <-- causal chain P1->P2->P3, correctly detected\");",
        "    }",
        "}",
        ""
      ]
    }
  ]
