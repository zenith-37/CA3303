      "order": 10,
      "file_name": "Peer.java",
      "topic": "Peer-to-Peer",
      "description": "Decentralized P2P chat node: each peer is both server and client; supports connect, peers, broadcast and exit commands.",
      "code": [
        "import java.io.*;",
        "import java.net.*;",
        "import java.util.*;",
        "import java.util.concurrent.*;",
        "",
        "/*",
        " * Simple decentralized Peer-to-Peer chat node.",
        " * Every peer is BOTH a server (accepts connections from other peers) and a",
        " * client (can initiate connections to other peers) - there is no central server.",
        " *",
        " * Run:   java Peer <myListenPort> [peerHost peerPort]...",
        " * Example (3 terminals on the same machine):",
        " *   java Peer 7001",
        " *   java Peer 7002 localhost 7001",
        " *   java Peer 7003 localhost 7001 localhost 7002",
        " *",
        " * Console commands once running:",
        " *   connect <host> <port>   -> connect to another peer at runtime",
        " *   peers                   -> list currently connected peers",
        " *   <any other text>        -> broadcast that message to all connected peers",
        " *   exit                    -> quit",
        " */",
        "public class Peer {",
        "    static int myPort;",
        "    static final Map<String, PrintWriter> connections = new ConcurrentHashMap<>();",
        "",
        "    public static void main(String[] args) throws IOException {",
        "        if (args.length < 1) {",
        "            System.out.println(\"Usage: java Peer <myListenPort> [peerHost peerPort]...\");",
        "            return;",
        "        }",
        "        myPort = Integer.parseInt(args[0]);",
        "",
        "        // 1. Start listening for incoming peer connections",
        "        new Thread(Peer::startServer).start();",
        "",
        "        // 2. Connect out to any peers given on the command line",
        "        for (int i = 1; i + 1 < args.length; i += 2) {",
        "            connectToPeer(args[i], Integer.parseInt(args[i + 1]));",
        "        }",
        "",
        "        // 3. Console loop",
        "        BufferedReader console = new BufferedReader(new InputStreamReader(System.in));",
        "        System.out.println(\"Peer started on port \" + myPort + \". Type 'peers', 'connect host port', or a message.\");",
        "        String line;",
        "        while ((line = console.readLine()) != null) {",
        "            if (line.equalsIgnoreCase(\"exit\")) {",
        "                System.exit(0);",
        "            } else if (line.equalsIgnoreCase(\"peers\")) {",
        "                System.out.println(\"Connected peers: \" + connections.keySet());",
        "            } else if (line.startsWith(\"connect \")) {",
        "                String[] parts = line.split(\"\\\\s+\");",
        "                connectToPeer(parts[1], Integer.parseInt(parts[2]));",
        "            } else {",
        "                broadcast(\"Peer-\" + myPort, line);",
        "            }",
        "        }",
        "    }",
        "",
        "    static void startServer() {",
        "        try (ServerSocket serverSocket = new ServerSocket(myPort)) {",
        "            while (true) {",
        "                Socket socket = serverSocket.accept();",
        "                registerConnection(socket);",
        "            }",
        "        } catch (IOException e) {",
        "            e.printStackTrace();",
        "        }",
        "    }",
        "",
        "    static void connectToPeer(String host, int port) {",
        "        try {",
        "            Socket socket = new Socket(host, port);",
        "            registerConnection(socket);",
        "            System.out.println(\"Connected to peer \" + host + \":\" + port);",
        "        } catch (IOException e) {",
        "            System.out.println(\"Could not connect to \" + host + \":\" + port + \" -> \" + e.getMessage());",
        "        }",
        "    }",
        "",
        "    static void registerConnection(Socket socket) {",
        "        String key = socket.getInetAddress().getHostAddress() + \":\" + socket.getPort();",
        "        try {",
        "            PrintWriter out = new PrintWriter(socket.getOutputStream(), true);",
        "            connections.put(key, out);",
        "            new Thread(() -> listenTo(socket, key)).start();",
        "        } catch (IOException e) {",
        "            e.printStackTrace();",
        "        }",
        "    }",
        "",
        "    static void listenTo(Socket socket, String key) {",
        "        try (BufferedReader in = new BufferedReader(new InputStreamReader(socket.getInputStream()))) {",
        "            String line;",
        "            while ((line = in.readLine()) != null) {",
        "                System.out.println(\"[\" + key + \"] \" + line);",
        "            }",
        "        } catch (IOException ignored) {",
        "        } finally {",
        "            connections.remove(key);",
        "            System.out.println(\"Peer \" + key + \" disconnected.\");",
        "        }",
        "    }",
        "",
        "    static void broadcast(String from, String message) {",
        "        for (PrintWriter out : connections.values()) {",
        "            out.println(from + \": \" + message);",
        "        }",
        "        if (connections.isEmpty()) {",
        "            System.out.println(\"(no peers connected yet - message not sent anywhere)\");",
        "        }",
        "    }",
        "}",
        ""
      ]
    },
