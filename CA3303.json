      "order": 6,
      "file_name": "Server.java",
      "topic": "TCP (multi-threaded)",
      "description": "Multi-threaded TCP server: one handler thread per client, replies with the reversed text of each line.",
      "code": [
        "import java.io.*;",
        "import java.net.*;",
        "",
        "/*",
        " * Classic multi-threaded TCP client-server.",
        " * Server accepts many clients concurrently; each client gets its own handler thread.",
        " * Service: reverses whatever line of text the client sends (\"PING\" style demo).",
        " */",
        "public class Server {",
        "    static final int PORT = 6000;",
        "",
        "    public static void main(String[] args) throws IOException {",
        "        try (ServerSocket serverSocket = new ServerSocket(PORT)) {",
        "            System.out.println(\"Server listening on port \" + PORT);",
        "            while (true) {",
        "                Socket clientSocket = serverSocket.accept();",
        "                System.out.println(\"Client connected: \" + clientSocket.getRemoteSocketAddress());",
        "                new Thread(() -> handle(clientSocket)).start();",
        "            }",
        "        }",
        "    }",
        "",
        "    static void handle(Socket socket) {",
        "        try (BufferedReader in = new BufferedReader(new InputStreamReader(socket.getInputStream()));",
        "             PrintWriter out = new PrintWriter(socket.getOutputStream(), true)) {",
        "",
        "            String line;",
        "            while ((line = in.readLine()) != null) {",
        "                if (line.equalsIgnoreCase(\"exit\")) break;",
        "                String reversed = new StringBuilder(line).reverse().toString();",
        "                out.println(\"Echo(reversed): \" + reversed);",
        "            }",
        "        } catch (IOException e) {",
        "            System.out.println(\"Client disconnected abruptly: \" + e.getMessage());",
        "        } finally {",
        "            try { socket.close(); } catch (IOException ignored) {}",
        "        }",
        "    }",
        "}"
      ]
    },
