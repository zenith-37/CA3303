      "order": 2,
      "file_name": "UDPServer.java",
      "topic": "UDP",
      "description": "UDP server: listens on port 6001 with DatagramSocket, prints each client message and replies 'Server got: <msg>'.",
      "code": [
        "import java.net.*;",
        "",
        "public class UDPServer {",
        "    public static void main(String[] args) throws Exception {",
        "        DatagramSocket ds = new DatagramSocket(6001);",
        "        byte[] buf = new byte[1024];",
        "        System.out.println(\"Server waiting...\");",
        "",
        "        while (true) {",
        "            DatagramPacket p = new DatagramPacket(buf, buf.length);",
        "            ds.receive(p);",
        "            String msg = new String(p.getData(), 0, p.getLength());",
        "            if (msg.equals(\"exit\")) break;",
        "            System.out.println(\"Client: \" + msg);",
        "",
        "            byte[] reply = (\"Server got: \" + msg).getBytes();",
        "            ds.send(new DatagramPacket(reply, reply.length, p.getAddress(), p.getPort()));",
        "        }",
        "        ds.close();",
        "    }",
        "}",
        ""
      ]
