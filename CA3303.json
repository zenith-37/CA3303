      "topic": "REST",
      "description": "REST client using java.net.http.HttpClient, demonstrating GET, POST, PUT and DELETE on /students.",
      "code": [
        "import java.net.URI;",
        "import java.net.http.HttpClient;",
        "import java.net.http.HttpRequest;",
        "import java.net.http.HttpResponse;",
        "",
        "/*",
        " * REST client using java.net.http.HttpClient (built into the JDK since Java 11).",
        " * Demonstrates GET, POST, PUT and DELETE against RestServer.",
        " */",
        "public class RestClient {",
        "    static final String BASE = \"http://localhost:8080/students\";",
        "    static final HttpClient client = HttpClient.newHttpClient();",
        "",
        "    public static void main(String[] args) throws Exception {",
        "        System.out.println(\"GET all students:\");",
        "        get(BASE);",
        "",
        "        System.out.println(\"\\nPOST new student:\");",
        "        String created = post(BASE, \"{\\\"name\\\":\\\"Meera\\\",\\\"course\\\":\\\"IT\\\"}\");",
        "        System.out.println(created);",
        "",
        "        System.out.println(\"\\nGET all students again:\");",
        "        get(BASE);",
        "",
        "        System.out.println(\"\\nPUT update student 1:\");",
        "        put(BASE + \"/1\", \"{\\\"name\\\":\\\"Asha K\\\",\\\"course\\\":\\\"CSE-AI\\\"}\");",
        "",
        "        System.out.println(\"\\nDELETE student 2:\");",
        "        delete(BASE + \"/2\");",
        "",
        "        System.out.println(\"\\nGET all students (final state):\");",
        "        get(BASE);",
        "    }",
        "",
        "    static void get(String url) throws Exception {",
        "        HttpRequest req = HttpRequest.newBuilder(URI.create(url)).GET().build();",
        "        print(client.send(req, HttpResponse.BodyHandlers.ofString()));",
        "    }",
        "",
        "    static String post(String url, String jsonBody) throws Exception {",
        "        HttpRequest req = HttpRequest.newBuilder(URI.create(url))",
        "                .header(\"Content-Type\", \"application/json\")",
        "                .POST(HttpRequest.BodyPublishers.ofString(jsonBody))",
        "                .build();",
        "        HttpResponse<String> resp = client.send(req, HttpResponse.BodyHandlers.ofString());",
        "        print(resp);",
        "        return resp.body();",
        "    }",
        "",
        "    static void put(String url, String jsonBody) throws Exception {",
        "        HttpRequest req = HttpRequest.newBuilder(URI.create(url))",
        "                .header(\"Content-Type\", \"application/json\")",
        "                .PUT(HttpRequest.BodyPublishers.ofString(jsonBody))",
        "                .build();",
        "        print(client.send(req, HttpResponse.BodyHandlers.ofString()));",
        "    }",
        "",
        "    static void delete(String url) throws Exception {",
        "        HttpRequest req = HttpRequest.newBuilder(URI.create(url)).DELETE().build();",
        "        print(client.send(req, HttpResponse.BodyHandlers.ofString()));",
        "    }",
        "",
        "    static void print(HttpResponse<String> resp) {",
        "        System.out.println(\"Status \" + resp.statusCode() + \" -> \" + resp.body());",
        "    }",
        "}",
        ""
      ]
    },
    {
      "order": 12,
      "file_name": "RestServer.java",
      "topic": "REST",
      "description": "Minimal REST server using the JDK's built-in HttpServer with an in-memory /students resource and manual JSON handling.",
      "code": [
        "import com.sun.net.httpserver.HttpExchange;",
        "import com.sun.net.httpserver.HttpHandler;",
        "import com.sun.net.httpserver.HttpServer;",
        "",
        "import java.io.*;",
        "import java.net.InetSocketAddress;",
        "import java.nio.charset.StandardCharsets;",
        "import java.util.*;",
        "import java.util.concurrent.ConcurrentHashMap;",
        "import java.util.concurrent.atomic.AtomicInteger;",
        "import java.util.regex.Matcher;",
        "import java.util.regex.Pattern;",
        "",
        "/*",
        " * Minimal REST web service using only the JDK's built-in HTTP server",
        " * (com.sun.net.httpserver) -- no external libraries / Maven needed, so it",
        " * compiles and runs with plain javac/java, which is ideal for a lab exam.",
        " *",
        " * Resource: /students",
        " *   GET    /students        -> list all students (JSON array)",
        " *   GET    /students/{id}   -> get one student",
        " *   POST   /students        -> create a student. Body: {\"name\":\"John\",\"course\":\"CSE\"}",
        " *   PUT    /students/{id}   -> update a student. Body: {\"name\":\"John\",\"course\":\"CSE\"}",
        " *   DELETE /students/{id}   -> delete a student",
        " *",
        " * JSON is built/parsed manually with tiny helpers below (kept deliberately",
        " * simple - no Gson/Jackson - so there is nothing extra to download).",
        " */",
        "public class RestServer {",
        "",
        "    static class Student {",
        "        int id;",
        "        String name;",
        "        String course;",
        "        Student(int id, String name, String course) { this.id = id; this.name = name; this.course = course; }",
        "        String toJson() {",
        "            return String.format(\"{\\\"id\\\":%d,\\\"name\\\":\\\"%s\\\",\\\"course\\\":\\\"%s\\\"}\", id, esc(name), esc(course));",
        "        }",
        "    }",
        "",
        "    static final Map<Integer, Student> DB = new ConcurrentHashMap<>();",
        "    static final AtomicInteger NEXT_ID = new AtomicInteger(1);",
        "",
        "    static String esc(String s) { return s == null ? \"\" : s.replace(\"\\\"\", \"\\\\\\\"\"); }",
        "",
        "    // very small helper to pull \"key\":\"value\" pairs out of a flat JSON object body",
        "    static String extractField(String json, String field) {",
        "        Matcher m = Pattern.compile(\"\\\"\" + field + \"\\\"\\\\s*:\\\\s*\\\"([^\\\"]*)\\\"\").matcher(json);",
        "        return m.find() ? m.group(1) : null;",
        "    }",
        "",
        "    public static void main(String[] args) throws IOException {",
        "        // seed a couple of records",
        "        int id1 = NEXT_ID.getAndIncrement();",
        "        DB.put(id1, new Student(id1, \"Asha\", \"CSE\"));",
        "        int id2 = NEXT_ID.getAndIncrement();",
        "        DB.put(id2, new Student(id2, \"Ravi\", \"ECE\"));",
        "",
        "        HttpServer server = HttpServer.create(new InetSocketAddress(8080), 0);",
        "        server.createContext(\"/students\", new StudentsHandler());",
        "        server.setExecutor(null); // default executor",
        "        server.start();",
        "        System.out.println(\"REST server running at http://localhost:8080/students\");",
        "    }",
        "",
        "    static class StudentsHandler implements HttpHandler {",
        "        @Override",
        "        public void handle(HttpExchange exchange) throws IOException {",
        "            String method = exchange.getRequestMethod();",
        "            String path = exchange.getRequestURI().getPath(); // e.g. /students or /students/3",
        "            String[] parts = path.split(\"/\");",
        "            Integer id = (parts.length >= 3) ? Integer.parseInt(parts[2]) : null;",
        "",
        "            try {",
        "                switch (method) {",
        "                    case \"GET\":",
        "                        if (id == null) handleListAll(exchange);",
        "                        else handleGetOne(exchange, id);",
        "                        break;",
        "                    case \"POST\":",
        "                        handleCreate(exchange);",
        "                        break;",
        "                    case \"PUT\":",
        "                        handleUpdate(exchange, id);",
        "                        break;",
        "                    case \"DELETE\":",
        "                        handleDelete(exchange, id);",
        "                        break;",
        "                    default:",
        "                        sendResponse(exchange, 405, \"{\\\"error\\\":\\\"method not allowed\\\"}\");",
        "                }",
        "            } catch (NumberFormatException e) {",
        "                sendResponse(exchange, 400, \"{\\\"error\\\":\\\"invalid id\\\"}\");",
        "            }",
        "        }",
        "",
        "        void handleListAll(HttpExchange exchange) throws IOException {",
        "            StringBuilder sb = new StringBuilder(\"[\");",
        "            boolean first = true;",
        "            for (Student s : DB.values()) {",
        "                if (!first) sb.append(\",\");",
        "                sb.append(s.toJson());",
        "                first = false;",
        "            }",
        "            sb.append(\"]\");",
        "            sendResponse(exchange, 200, sb.toString());",
        "        }",
        "",
        "        void handleGetOne(HttpExchange exchange, int id) throws IOException {",
        "            Student s = DB.get(id);",
        "            if (s == null) sendResponse(exchange, 404, \"{\\\"error\\\":\\\"not found\\\"}\");",
        "            else sendResponse(exchange, 200, s.toJson());",
        "        }",
        "",
        "        void handleCreate(HttpExchange exchange) throws IOException {",
        "            String body = readBody(exchange);",
        "            String name = extractField(body, \"name\");",
        "            String course = extractField(body, \"course\");",
        "            int id = NEXT_ID.getAndIncrement();",
        "            Student s = new Student(id, name, course);",
        "            DB.put(id, s);",
        "            sendResponse(exchange, 201, s.toJson());",
        "        }",
        "",
        "        void handleUpdate(HttpExchange exchange, Integer id) throws IOException {",
        "            if (id == null || !DB.containsKey(id)) { sendResponse(exchange, 404, \"{\\\"error\\\":\\\"not found\\\"}\"); return; }",
        "            String body = readBody(exchange);",
        "            String name = extractField(body, \"name\");",
        "            String course = extractField(body, \"course\");",
        "            Student s = DB.get(id);",
        "            if (name != null) s.name = name;",
        "            if (course != null) s.course = course;",
        "            sendResponse(exchange, 200, s.toJson());",
        "        }",
        "",
        "        void handleDelete(HttpExchange exchange, Integer id) throws IOException {",
        "            if (id == null || DB.remove(id) == null) sendResponse(exchange, 404, \"{\\\"error\\\":\\\"not found\\\"}\");",
        "            else sendResponse(exchange, 200, \"{\\\"deleted\\\":\" + id + \"}\");",
        "        }",
        "",
        "        String readBody(HttpExchange exchange) throws IOException {",
        "            ByteArrayOutputStream bos = new ByteArrayOutputStream();",
        "            InputStream is = exchange.getRequestBody();",
        "            byte[] buf = new byte[1024];",
        "            int n;",
        "            while ((n = is.read(buf)) != -1) bos.write(buf, 0, n);",
        "            return bos.toString(StandardCharsets.UTF_8.name());",
        "        }",
        "",
        "        void sendResponse(HttpExchange exchange, int status, String json) throws IOException {",
        "            byte[] bytes = json.getBytes(StandardCharsets.UTF_8);",
        "            exchange.getResponseHeaders().set(\"Content-Type\", \"application/json\");",
        "            exchange.sendResponseHeaders(status, bytes.length);",
        "            try (OutputStream os = exchange.getResponseBody()) {",
        "                os.write(bytes);",
        "            }",
        "        }",
        "    }",
        "}",
        ""
      ]
