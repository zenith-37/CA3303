      "order": 13,
      "file_name": "RpcClient.java",
      "topic": "Hand-written RPC",
      "description": "RPC client stub: wraps socket and marshalling details behind add/sub/mul/div method calls on port 5000.",
      "code": [
        "import java.io.*;",
        "import java.net.*;",
        "",
        "/*",
        " * Hand-written RPC client (\"stub\"): hides the socket/marshalling details",
        " * behind plain method calls, exactly like a generated RMI stub would.",
        " */",
        "public class RpcClient {",
        "    private final String host;",
        "    private final int port;",
        "",
        "    public RpcClient(String host, int port) {",
        "        this.host = host;",
        "        this.port = port;",
        "    }",
        "",
        "    private Object invoke(String method, double a, double b) throws IOException, ClassNotFoundException {",
        "        try (Socket socket = new Socket(host, port);",
        "             ObjectOutputStream out = new ObjectOutputStream(socket.getOutputStream());",
        "             ObjectInputStream in = new ObjectInputStream(socket.getInputStream())) {",
        "",
        "            out.writeObject(new RpcRequest(method, a, b));",
        "            RpcResponse resp = (RpcResponse) in.readObject();",
        "            if (resp.error != null) throw new RuntimeException(\"Remote error: \" + resp.error);",
        "            return resp.result;",
        "        }",
        "    }",
        "",
        "    public double add(double a, double b) throws Exception { return (double) invoke(\"add\", a, b); }",
        "    public double sub(double a, double b) throws Exception { return (double) invoke(\"sub\", a, b); }",
        "    public double mul(double a, double b) throws Exception { return (double) invoke(\"mul\", a, b); }",
        "    public double div(double a, double b) throws Exception { return (double) invoke(\"div\", a, b); }",
        "",
        "    public static void main(String[] args) throws Exception {",
        "        RpcClient stub = new RpcClient(\"localhost\", 5000);",
        "        System.out.println(\"10 + 5 = \" + stub.add(10, 5));",
        "        System.out.println(\"10 - 5 = \" + stub.sub(10, 5));",
        "        System.out.println(\"10 * 5 = \" + stub.mul(10, 5));",
        "        System.out.println(\"10 / 5 = \" + stub.div(10, 5));",
        "    }",
        "}",
        ""
      ]
    },
